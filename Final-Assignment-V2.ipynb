        "id": "predict_labels_fn"
      },
      "outputs": [],
      "source": [
        "# Predict labels for department and seniority\n",
        "def predict_labels(df, department_dict, seniority_dict, text_col=\"position\"):\n",
        "    positions = df[text_col].fillna(\"\").str.lower()\n",
        "    return pd.DataFrame({\n",
        "        \"person_id\": df[\"person_id\"],\n",
        "        \"pred_department\": positions.apply(lambda x: dict_match(x, department_dict)),\n",
        "        \"pred_seniority\": positions.apply(lambda x: dict_match(x, seniority_dict)),\n",
        "    })\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "evaluate_accuracy_fn"
      },
      "outputs": [],
      "source": [
        "# Evaluate coverage and accuracy of predictions against labeled data\n",
        "def evaluate_accuracy(df_with_labels, preds_df):\n",
        "    merged = df_with_labels.merge(\n",
        "        preds_df[[\"person_id\", \"pred_department\", \"pred_seniority\"]],\n",
        "        on=\"person_id\",\n",
        "        how=\"left\"\n",
        "    )\n",
        "\n",
        "    dept_coverage = merged[\"pred_department\"].notna().mean()\n",
        "    sen_coverage = merged[\"pred_seniority\"].notna().mean()\n",
        "\n",
        "    dept_eval = merged.dropna(subset=[\"department\", \"pred_department\"])\n",
        "    sen_eval = merged.dropna(subset=[\"seniority\", \"pred_seniority\"])\n",
        "\n",
        "    dept_accuracy = (dept_eval[\"department\"] == dept_eval[\"pred_department\"]).mean()\n",
        "    sen_accuracy = (sen_eval[\"seniority\"] == sen_eval[\"pred_seniority\"]).mean()\n",
        "\n",
        "    return {\n",
        "        \"department_coverage\": dept_coverage,\n",
        "        \"seniority_coverage\": sen_coverage,\n",
        "        \"department_accuracy\": dept_accuracy,\n",
        "        \"seniority_accuracy\": sen_accuracy,\n",
        "    }\n"
      ]
    },
        "preds = predict_labels(df_active_no_labels, department_dict, seniority_dict)\n",
        "df_active_no_labels = df_active_no_labels.merge(\n",
        "    preds[[\"person_id\", \"pred_department\", \"pred_seniority\"]],\n",
        "    on=\"person_id\",\n",
        "    how=\"left\"\n",
        ")\n"
        "metrics = evaluate_accuracy(df_active, preds)\n",
        "print(f\"Department Coverage: {metrics['department_coverage']:.2%}\")\n",
        "print(f\"Seniority Coverage: {metrics['seniority_coverage']:.2%}\")\n"
        "dept_accuracy = metrics['department_accuracy']\n",
        "print(f\"Department Accuracy: {dept_accuracy:.2%}\")\n"
        "sen_accuracy = metrics['seniority_accuracy']\n",
        "print(f\"Seniority Accuracy: {sen_accuracy:.2%}\")\n"